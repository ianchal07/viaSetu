# Network
HOST=192.168.1.10
PORT=8080

# Filesystem
ROOT_DIR=C:\\Shared
LIST_BASE_DIR=shared-private
MAX_UPLOAD_SIZE_BYTES=1073741824
MAX_CHUNK_SIZE_BYTES=8388608
UPLOAD_TTL_SECONDS=3600
LIST_PAGE_SIZE_DEFAULT=100
LIST_PAGE_SIZE_MAX=500

# Authentication (bcrypt hashes)
SESSION_SECRET=replace-with-long-random-secret
AUTH_READWRITE_HASH=$2b$12$replace_with_bcrypt_hash
AUTH_READONLY_HASH=
SESSION_TTL_SECONDS=3600
SESSION_COOKIE_SECURE=false

# Brute force and rate limits
LOGIN_WINDOW_SECONDS=300
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
RATE_IP_WINDOW_SECONDS=60
RATE_IP_MAX_REQUESTS=240
RATE_SESSION_WINDOW_SECONDS=60
RATE_SESSION_MAX_REQUESTS=180

# Logging
LOG_LEVEL=info
